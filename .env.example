# ==============================================================================
# PORTAL DE DEMANDAS - PREFEITURA DE BELMONTE
# Arquitetura Monolítica Next.js (Vercel) + Firebase Firestore + Google Drive
# Copie este arquivo para .env e preencha os valores reais
# ==============================================================================

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Firestore)
# Console Firebase -> Configurações do Projeto -> Contas de serviço -> Gerar nova chave privada
# IMPORTANTE: mantenha as aspas duplas em FIREBASE_PRIVATE_KEY e os "\n" literais.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="seu-projeto-firebase"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto-firebase.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI_SUA_CHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# NextAuth.js (Auth.js)
# Gere um segredo seguro com: openssl rand -base64 32
# Em produção na Vercel, NEXTAUTH_URL deve ser o domínio final (ex: https://demandas.belmonte.ba.gov.br)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais"

# ------------------------------------------------------------------------------
# Google Drive API v3 (OAuth2 na conta Google da Agência - Upload Direto Resumable)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret"
GOOGLE_DRIVE_REFRESH_TOKEN="seu-refresh-token-permanente"
GOOGLE_DRIVE_ROOT_FOLDER_ID="id-da-pasta-raiz-no-google-drive"

# ------------------------------------------------------------------------------
# Seed Inicial (usado por `npm run db:seed` e pela rota protegida POST /api/seed)
# ------------------------------------------------------------------------------
SEED_SECRET="defina-um-token-secreto-para-proteger-a-rota-api-seed"
SEED_ADMIN_NAME="Agência de Marketing - Admin"
SEED_ADMIN_EMAIL="admin@belmonte.ba.gov.br"
SEED_ADMIN_PASSWORD="Admin@2026"
